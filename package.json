{
  "name": "scheduler-deadline",
  "version": "1.0.0",
  "description": "A module for scheduling deadlines.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run lint && npm run type-check && npm run test:coverage && npm run build"
  },
  "keywords": [
    "scheduler",
    "deadline",
    "task"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.66.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SifisoScS/scheduler-deadline.git"
  },
  "author": "Sifiso Cyprian Shezi",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/SifisoScS/scheduler-deadline/issues"
  },
  "homepage": "https://github.com/SifisoScS/scheduler-deadline#readme"
}
